# Copia este archivo como ".env" (NO se sube a GitHub) y completa los valores.
# Ver docs/04-superadmin.md y docs/07-credenciales.md

# --- Proyecto de Firebase ---------------------------------------------------
# ID del proyecto real (Configuración del proyecto > General > ID del proyecto)
FIREBASE_PROJECT_ID=tu-project-id

# Ruta al JSON de la cuenta de servicio (Configuración > Cuentas de servicio >
# Generar nueva clave privada). Solo para scripts locales, nunca para la app.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# --- Superadmin (creador de la app) -----------------------------------------
# Usuario maestro: con estas credenciales inicias sesión en la app y ves las
# "Opciones maestras" (consumo de Firebase, deshabilitar usuarios y tiendas).
SUPERADMIN_EMAIL=tu-correo@ejemplo.com
SUPERADMIN_PASSWORD=una-contraseña-larga-y-segura
SUPERADMIN_NAME=Administrador del sistema

# --- Alertas de consumo (Cloud Monitoring) ----------------------------------
# Correo que recibe las alertas cuando un recurso llega al 80 % de la cuota gratuita.
ALERT_EMAIL=tu-correo@ejemplo.com

# --- Solo para pruebas locales contra el emulador ----------------------------
# Descomenta para que los scripts apunten al Firebase Emulator Suite.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
