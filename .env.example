# Supabase Free. Completar después de crear el proyecto. Nunca subir .env a Git.
SUPABASE_URL=
# Clave pública anon JWT o sb_publishable_... (también se usa en Android).
SUPABASE_ANON_KEY=
# Solo scripts locales/CI. JAMÁS se incluye en la app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# Opcional: login nativo con Google; configurar también el proveedor en Supabase.
GOOGLE_WEB_CLIENT_ID=

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Administrador del sistema
