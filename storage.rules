rules_version = '2';

// =============================================================================
// Control Tienda - Reglas de Cloud Storage ("carpeta del servidor")
//  - Límite máximo de 5 MB por archivo.
//  - Firestore solo guarda la RUTA del archivo (p. ej. stores/abc/products/uuid.jpg).
//  - Los nombres son UUID aleatorios: un archivo nunca se sobrescribe, se reemplaza
//    por uno nuevo y la función de limpieza borra el anterior.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function underLimit() { return request.resource.size < 5 * 1024 * 1024; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function isDocument() {
      return isImage() || request.resource.contentType in [
        'application/pdf',
        'application/vnd.ms-excel',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
      ];
    }

    function memberDoc(storeId) {
      return /databases/(default)/documents/stores/$(storeId)/members/$(request.auth.uid);
    }
    function can(storeId, perm) {
      return firestore.exists(memberDoc(storeId))
        && firestore.get(memberDoc(storeId)).data.active == true
        && (firestore.get(memberDoc(storeId)).data.role == 'owner'
          || (firestore.get(memberDoc(storeId)).data.role == 'employee'
            && perm in firestore.get(memberDoc(storeId)).data.permissions));
    }

    function canUpload(storeId, folder) {
      return (folder == 'store' && can(storeId, 'edit_store'))
        || (folder == 'categories' && can(storeId, 'manage_categories'))
        || (folder == 'products' && (can(storeId, 'manage_products') || can(storeId, 'receptions')))
        || (folder == 'receptions' && can(storeId, 'receptions'));
    }

    // Avatar del usuario
    match /users/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId && underLimit() && isImage();
    }

    // Fotos de la tienda, categorías, productos y facturas de recepciones
    match /stores/{storeId}/{folder}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && underLimit() && isDocument() && canUpload(storeId, folder);
    }
  }
}
