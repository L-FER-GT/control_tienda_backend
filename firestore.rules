rules_version = '2';

// =============================================================================
// Control Tienda - Reglas de seguridad de Cloud Firestore
//
// Modelo de acceso (ver docs/09-reglas-de-seguridad.md):
//  - Los roles son POR TIENDA: owner (administrador), employee (empleado), client (cliente).
//  - Cada tienda tiene un único owner. Los empleados reciben permisos delegados.
//  - Tiendas públicas: cualquier usuario autenticado ve la tienda, sus categorías y productos.
//  - Superadmin (creador de la app): custom claim "superadmin", asignado solo por script.
//  - Todo lo que no está permitido explícitamente está denegado.
//  - Lo que hace el servidor (números de orden, stock, invitaciones aceptadas,
//    historial por recepciones) solo lo escriben las Cloud Functions (Admin SDK).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ utilidades
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSuper() { return signedIn() && request.auth.token.get('superadmin', false) == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changedKeys() { return incoming().diff(existing()).affectedKeys(); }
    function onlyChanges(keys) { return changedKeys().hasOnly(keys); }

    function isMoney(v) { return v is int && v >= 0; }
    function isOptMoney(v) { return v == null || isMoney(v); }
    function isOptNumber(v) { return v == null || v is number; }
    function isText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function isOptText(v, max) { return v == null || (v is string && v.size() <= max); }

    // ------------------------------------------------------------ tiendas y membresías
    function storePath(storeId) { return /databases/$(database)/documents/stores/$(storeId); }
    function memberPath(storeId, memberId) {
      return /databases/$(database)/documents/stores/$(storeId)/members/$(memberId);
    }
    function storeData(storeId) { return get(storePath(storeId)).data; }
    function storeEnabled(storeId) { return storeData(storeId).get('disabledBySystem', false) == false; }

    function isMember(storeId) { return signedIn() && exists(memberPath(storeId, uid())); }
    function me(storeId) { return get(memberPath(storeId, uid())).data; }
    function isActiveMember(storeId) { return isMember(storeId) && me(storeId).active == true; }
    function isOwner(storeId) { return isActiveMember(storeId) && me(storeId).role == 'owner'; }
    function isStaff(storeId) { return isActiveMember(storeId) && me(storeId).role in ['owner', 'employee']; }

    // El dueño puede todo; un empleado solo lo que se le delegó.
    function can(storeId, perm) {
      return isActiveMember(storeId)
        && (me(storeId).role == 'owner' || (me(storeId).role == 'employee' && perm in me(storeId).permissions));
    }
    function canWrite(storeId, perm) { return storeEnabled(storeId) && can(storeId, perm); }

    // Ver la tienda y su catálogo: pública, miembro activo o superadmin.
    function canView(storeId) {
      return isSuper() || (signedIn() && (storeData(storeId).isPublic == true || isActiveMember(storeId)));
    }

    // ======================================================================== usuarios
    match /users/{userId} {
      // El perfil lo crea la función bootstrapUser (genera el código único de 10 dígitos).
      allow read: if signedIn() && (uid() == userId || isSuper());
      allow update: if signedIn() && uid() == userId
        && onlyChanges(['displayName', 'phone', 'photoPath', 'updatedAt'])
        && isText(incoming().displayName, 80)
        && isOptText(incoming().get('phone', null), 30)
        && isOptText(incoming().get('photoPath', null), 300);

      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && uid() == userId;
        allow update: if signedIn() && uid() == userId && onlyChanges(['read']) && incoming().read is bool;
      }

      // Tokens de FCM del usuario (uno por dispositivo).
      match /devices/{token} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId && incoming().token == token;
      }
    }

    // Datos públicos mínimos para buscar e invitar usuarios (nombre, foto y código).
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow update: if signedIn() && uid() == userId
        && onlyChanges(['displayName', 'displayNameLower', 'photoPath', 'updatedAt'])
        && isText(incoming().displayName, 80)
        && incoming().displayNameLower == incoming().displayName.lower();
    }

    // Índice código -> uid. Solo lectura puntual (no se puede listar).
    match /userCodes/{code} {
      allow get: if signedIn();
    }

    // ======================================================================== tiendas
    match /stores/{storeId} {
      function validStore(d) {
        return isText(d.name, 80)
          && d.nameLower == d.name.lower()
          && isText(d.address, 200)
          && d.isPublic is bool
          && d.currency is string && d.currency.size() == 3
          && isOptText(d.get('photoPath', null), 300);
      }

      allow read: if isSuper() || (signedIn() && (resource.data.isPublic == true || isActiveMember(storeId)));
      allow create: if signedIn()
        && incoming().ownerId == uid()
        && incoming().get('disabledBySystem', false) == false
        && validStore(incoming());
      allow update: if canWrite(storeId, 'edit_store')
        && validStore(incoming())
        && !changedKeys().hasAny(['ownerId', 'ownerName', 'disabledBySystem', 'createdAt']);

      // ------------------------------------------------------------ miembros
      match /members/{memberId} {
        allow read: if signedIn() && (uid() == memberId || can(storeId, 'members') || isSuper());

        // El dueño registra su propia membresía en el mismo batch en que crea la tienda.
        allow create: if signedIn() && memberId == uid()
          && getAfter(storePath(storeId)).data.ownerId == uid()
          && incoming().uid == uid()
          && incoming().role == 'owner'
          && incoming().active == true;

        // Habilitar/deshabilitar y cambiar permisos. Nunca al dueño ni a uno mismo.
        // Los clientes no tienen permisos de administrador.
        allow update: if canWrite(storeId, 'members')
          && memberId != uid()
          && existing().role != 'owner'
          && onlyChanges(['active', 'permissions', 'updatedAt'])
          && incoming().active is bool
          && incoming().permissions is list
          && (existing().role == 'employee' || incoming().permissions.size() == 0);
      }

      // ------------------------------------------------------------ invitaciones
      // Las acepta/rechaza el invitado mediante la función respondInvitation.
      match /invitations/{invitationId} {
        allow read: if signedIn() && (can(storeId, 'members') || resource.data.toUid == uid());
        allow create: if canWrite(storeId, 'members')
          && incoming().fromUid == uid()
          && incoming().toUid != uid()
          && incoming().storeId == storeId
          && incoming().status == 'pending'
          && incoming().role in ['employee', 'client']
          && isText(incoming().toUid, 128);
        allow update: if canWrite(storeId, 'members')
          && existing().status == 'pending'
          && incoming().status == 'cancelled'
          && onlyChanges(['status', 'respondedAt']);
      }

      // ------------------------------------------------------------ catálogo
      match /categories/{categoryId} {
        allow read: if canView(storeId);
        allow create, update: if canWrite(storeId, 'manage_categories')
          && isText(incoming().name, 60)
          && isOptText(incoming().get('photoPath', null), 300);
        allow delete: if canWrite(storeId, 'manage_categories');
      }

      match /products/{productId} {
        function validProduct(d) {
          return isText(d.name, 120)
            && d.nameLower == d.name.lower()
            && isMoney(d.salePriceCents)
            && isOptMoney(d.get('purchaseCostCents', null))
            && isOptNumber(d.get('stock', null))
            && (d.get('stockAlert', null) == null || (d.stockAlert is number && d.stockAlert > 0))
            && isOptText(d.get('barcode', null), 64)
            && isOptText(d.get('qrCode', null), 512)
            && isOptText(d.get('photoPath', null), 300)
            && isOptText(d.get('categoryId', null), 128)
            && d.unit is string;
        }

        allow read: if canView(storeId);
        // También se crean productos desde "Recepción de mercadería".
        allow create: if (canWrite(storeId, 'manage_products') || canWrite(storeId, 'receptions'))
          && validProduct(incoming());
        // Con permiso de categorías solo se puede cambiar la categoría.
        allow update: if validProduct(incoming()) && (
          canWrite(storeId, 'manage_products')
          || (canWrite(storeId, 'manage_categories') && onlyChanges(['categoryId', 'updatedAt', 'updatedBy']))
        );
        allow delete: if canWrite(storeId, 'manage_products');

        // Historial de precios de venta y costos de compra.
        match /priceHistory/{entryId} {
          allow read: if can(storeId, 'manage_products') || can(storeId, 'reports');
          allow create: if (canWrite(storeId, 'manage_products') || canWrite(storeId, 'receptions'))
            && incoming().changedBy == uid()
            && isOptMoney(incoming().get('salePriceCents', null))
            && isOptMoney(incoming().get('purchaseCostCents', null));
        }
      }

      // ------------------------------------------------------------ ventas
      // Se crean sin conexión con número null; el servidor asigna el correlativo y descuenta stock.
      match /orders/{orderId} {
        allow read: if signedIn() && (
          (resource.data.createdBy == uid() && isStaff(storeId))
          || can(storeId, 'reports')
          || isSuper()
        );
        allow create: if storeEnabled(storeId) && isStaff(storeId)
          && incoming().createdBy == uid()
          && incoming().get('number', null) == null
          && incoming().status == 'pending'
          && incoming().get('stockApplied', false) == false
          && incoming().items is list
          && incoming().items.size() > 0
          && incoming().items.size() <= 300
          && isMoney(incoming().totalCents)
          && incoming().createdAt is timestamp
          && incoming().paymentMethod is string;
        // Sin anulaciones ni ediciones desde el cliente.
      }

      // ------------------------------------------------------------ compras
      match /suppliers/{supplierId} {
        allow read: if can(storeId, 'suppliers') || can(storeId, 'receptions') || can(storeId, 'reports');
        // "otros" es virtual: existe siempre y no se guarda.
        allow create, update: if canWrite(storeId, 'suppliers')
          && supplierId != 'otros'
          && isText(incoming().companyName, 120)
          && isOptText(incoming().get('ruc', null), 11)
          && isOptText(incoming().get('phone', null), 30);
        allow delete: if canWrite(storeId, 'suppliers') && supplierId != 'otros';
      }

      // El stock y el costo los aplica la función onReceptionWritten (también al editar).
      match /receptions/{receptionId} {
        function validReception(d) {
          return d.supplierId is string
            && isText(d.supplierName, 120)
            && d.lines is list && d.lines.size() <= 300
            && d.invoicePhotos is list && d.invoicePhotos.size() <= 10
            && isOptMoney(d.get('invoiceTotalCents', null))
            && d.receivedAt is timestamp;
        }

        allow read: if can(storeId, 'receptions') || can(storeId, 'reports');
        allow create: if canWrite(storeId, 'receptions') && validReception(incoming()) && incoming().createdBy == uid();
        allow update: if canWrite(storeId, 'receptions') && validReception(incoming())
          && !changedKeys().hasAny(['createdBy', 'createdAt']);
      }

      // ledgers/ y meta/ son exclusivos del servidor: sin reglas = denegado.
    }

    // Consultas collection group: "¿en qué tiendas soy miembro?"
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == uid();
    }
  }
}
